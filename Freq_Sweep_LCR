#define PICOLCR_BUMP_VREG 1

// Record length ceiling PER CHANNEL. The interleaved buffer is twice this.
// 2 x 4000 x 2 bytes = 16 kB, same footprint as v2's two separate buffers.
static const uint16_t N_ABS_MAX = 4000;

// =============================================================================
//                              TUNING BLOCK
// =============================================================================
// Everything that trades measurement time against accuracy lives here.
//
// m_target        Samples per cycle per channel. The ADC divisor is
//                recomputed at every frequency point to hold this roughly
//                constant, so fs_agg = 2 * m_target * f, clamped to the
//                hardware ceiling (clk_adc / 96). Above the crossover
//                frequency fs_agg pins at the ceiling and the achieved
//                samples/cycle falls as fs_ch / f instead.
//
// target_cycles  Whole cycles of the excitation integrated per capture. Primary
//                accuracy knob. Noise falls as sqrt(cycles) and the Goertzel
//                noise bandwidth narrows as fs/n.
//
// n_min          Record length floor in samples per channel. Guards against a
//                record too short for the Goertzel to integrate.
//
// n_max          Record length ceiling in samples per channel. Caps RAM and
//                time at low frequency.
//
// averages       Repeat captures per frequency point, averaged in the Z domain.
//                Noise falls as sqrt(averages). Prefer raising target_cycles
//                first; raise averages when the limiter is drift or
//                intermittent interference rather than white noise.
//
// window         Hann window. Still necessary while  the AD9833 crystal is
//                asynchronous to the RP2040. Costs ~1.8 dB SNR, buys ~31 dB sidelobe suppression, and its
//                coherent gain cancels in the V_DUT/V_Rsense ratio so it does
//                not bias the result.
//
// settle_ms      Delay after a frequency change before capturing. The AD9833
//                retunes within one MCLK, so this is for the analog
//                front end.
//
// max_point_ms   Per-point capture time budget. Trims target_cycles when a low
//                frequency point would otherwise dominate the sweep. 0 = off.
//                n_min always wins over this.
//
// min_spc        Samples per cycle below which the point is flagged marginal.
//                Note this is now normally satisfied by construction below the
//                crossover frequency, so it mostly catches the high end.
//
// low_snr_counts Peak amplitude across R_sense, in ADC counts, below which the
//                point is flagged. 20 counts is about 16 mV peak.
// =============================================================================

struct MeasCfg {
  uint16_t m_target;         // samples per cycle per channel
  uint16_t target_cycles;
  uint16_t n_min;
  uint16_t n_max;
  uint8_t  averages;
  bool     window;
  uint16_t settle_ms;
  uint16_t max_point_ms;
  float    min_spc;
  float    low_snr_counts;
};

