// Try to get clk_sys to TARGET_SYS_KHZ. If the CPU Speed menu already did it,
// this is a no-op. Returns true if we are within 1% of target.
static bool ensureSysClock() {
  uint32_t want_hz = TARGET_SYS_KHZ * 1000UL;
  uint32_t have_hz = clock_get_hz(clk_sys);

  if (have_hz >= want_hz - want_hz / 100 && have_hz <= want_hz + want_hz / 100) {
    return true;
  }

#if PICOLCR_BUMP_VREG
  vreg_set_voltage(VREG_VOLTAGE_1_15);
  delay(2);   // let the regulator settle before asking the PLL to go faster
#endif

  // The 'true' argument makes this return false rather than hang if the PLL
  // configuration is unreachable.
  if (!set_sys_clock_khz(TARGET_SYS_KHZ, true)) return false;

  return true;
}

// Re-source clk_adc from PLL_SYS / 2. Stock is PLL_USB at 48 MHz.
//
// CLK_ADC_DIV has a 2-bit integer field and no fractional part, so the only
// available divisors are 1, 2 and 3. With clk_sys at 192 MHz, /2 lands on
// 96 MHz. If clk_sys ended up somewhere else this still works, it just gives a
// different clk_adc, which is why g_adc_clk_hz is read back rather than
// assumed and g_fs_agg_max is derived from it.
static void adcClockBoost(uint32_t div) {
  if (div < 1) div = 1;
  if (div > 3) div = 3;
  g_adc_div_sel = div;

  uint32_t pll = clock_get_hz(clk_sys);   // == pll_sys when CLK_SYS_DIV is 1

  clock_configure(clk_adc,
                  0,                      // clk_adc has no glitchless mux
                  CLOCKS_CLK_ADC_CTRL_AUXSRC_VALUE_CLKSRC_PLL_SYS,
                  pll,
                  pll / div);

  g_adc_clk_hz = clock_get_hz(clk_adc);

  // Ceiling stays clk_adc / 96. NOT clamped to the datasheet 500 kS/s: that
  // number assumes a 48 MHz clk_adc. Whether a given part honours a shorter
  // conversion period is an empirical question -- see the fs_meas column in
  // 'y' and FLAG_FS_MISMATCH.
  g_fs_agg_max = (float)g_adc_clk_hz / 96.0f;
}

static void captureInit() {
  adc_gpio_init(ADC0_GPIO);
  adc_gpio_init(ADC1_GPIO);
  adc_init();
  adc_set_temp_sensor_enabled(false);
  g_dma_chan = dma_claim_unused_channel(true);
}

// Program the aggregate conversion rate. Returns the ACTUAL rate achieved,
// which is what the Goertzel must be told about.
//
// Sample period is (1 + div) clk_adc cycles, clamped by hardware to a minimum
// of 96. div is written as an integer so FRAC stays zero -- a nonzero
// fractional divisor dithers the conversion period, and period dither is
// sampling jitter.
static float captureSetRate(float fs_agg_target) {
  if (fs_agg_target < 1.0f) fs_agg_target = 1.0f;

  float d = (float)g_adc_clk_hz / fs_agg_target - 1.0f;
  if (d < 95.0f)     d = 95.0f;        // 96-cycle conversion floor
  if (d > 65535.0f)  d = 65535.0f;     // ADC DIV.INT is 16 bits

  uint32_t di = (uint32_t)(d + 0.5f);
  adc_set_clkdiv((float)di);

  g_period_cyc = di + 1;
  g_fs_agg     = (float)g_adc_clk_hz / (float)g_period_cyc;
  g_fs_hz      = g_fs_agg * 0.5f;

  // ADC1 is converted in the slot immediately after ADC0, so the skew is
  // exactly one aggregate sample period. Exact, not estimated.
  g_skew_s     = (float)g_period_cyc / (float)g_adc_clk_hz;

  return g_fs_agg;
}

// One-shot round-robin capture of n_per_ch samples per channel into buf_rr.
//
// Ordering matters and is easy to get subtly wrong:
//   1. stop the ADC and clear round robin BEFORE selecting the start channel,
//      so AINSEL is not advancing while we set it
//   2. drain the FIFO, so no stale sample lands at buf_rr[0]
//   3. select ADC_CH_A, so buf_rr[0] is deterministically channel A
//   4. arm DMA, THEN start conversions -- the other order drops samples
//
// Returns false on FIFO over/underflow or channel parity slip. A single
// overflow shifts parity for the entire remainder of the buffer, which shows
// up downstream as a ~180 degree phase error rather than as missing data, so
// this return value is worth checking on every record.
static bool captureRoundRobin(uint16_t n_per_ch) {
  if (n_per_ch == 0 || n_per_ch > N_ABS_MAX) return false;
  uint32_t total = (uint32_t)n_per_ch * 2u;   // always even

  adc_run(false);
  adc_set_round_robin(0);
  adc_fifo_drain();
  adc_select_input(ADC_CH_A);
  adc_set_round_robin((1u << ADC_CH_A) | (1u << ADC_CH_B));

  adc_fifo_setup(true,    // enable FIFO
                 true,    // DREQ enable
                 1,       // assert DREQ on every sample
                 false,   // do NOT put the error bit in the FIFO
                 false);  // do NOT byte-shift: keep all 12 bits

  // Clear sticky over/underflow (write-1-clear) so the post-capture read
  // reflects this record only.
  hw_set_bits(&adc_hw->fcs, ADC_FCS_OVER_BITS | ADC_FCS_UNDER_BITS);

  dma_channel_config c = dma_channel_get_default_config(g_dma_chan);
  channel_config_set_transfer_data_size(&c, DMA_SIZE_16);
  channel_config_set_read_increment(&c, false);   // FIFO is a fixed address
  channel_config_set_write_increment(&c, true);
  channel_config_set_dreq(&c, DREQ_ADC);
  channel_config_set_high_priority(&c, true);

  dma_channel_configure(g_dma_chan, &c,
                        buf_rr,           // dst
                        &adc_hw->fifo,    // src
                        total,
                        true);            // arm and start waiting on DREQ

  // Time ONLY the run, not the setup. If the ADC cannot honour the programmed
  // conversion period the DMA still completes and no error bit is raised, so
  // the achieved rate is the only observable that tells us.
  uint32_t t0 = time_us_32();
  adc_run(true);
  dma_channel_wait_for_finish_blocking(g_dma_chan);
  uint32_t t1 = time_us_32();
  adc_run(false);

  g_cap_run_us = t1 - t0;
  g_cap_n_last = n_per_ch;
  if (g_cap_run_us > 0) {
    g_fs_agg_meas = (float)total / ((float)g_cap_run_us * 1e-6f);
    g_fs_meas_ch  = g_fs_agg_meas * 0.5f;
  }

  bool     ovf    = (adc_hw->fcs & (ADC_FCS_OVER_BITS | ADC_FCS_UNDER_BITS)) != 0;
  uint32_t ainsel = (adc_hw->cs & ADC_CS_AINSEL_BITS) >> ADC_CS_AINSEL_LSB;

  adc_fifo_drain();
  adc_set_round_robin(0);

  // total is even, so AINSEL should have wrapped back to channel A.
  return !ovf && (ainsel == ADC_CH_A);
}

static void adcReport() {
  Serial.println();
  Serial.print(F("[clk] clk_sys = "));
  Serial.print(clock_get_hz(clk_sys) / 1000000.0f, 2);
  Serial.print(F(" MHz"));
  if (!g_sysclk_ok) Serial.print(F("  (TARGET NOT REACHED)"));
  Serial.println();

  Serial.print(F("[clk] clk_adc = "));
  Serial.print(g_adc_clk_hz / 1000000.0f, 2);
  Serial.print(F(" MHz  ->  fs_agg_max = "));
  Serial.print(g_fs_agg_max / 1000.0f, 1);
  Serial.print(F(" kS/s aggregate, "));
  Serial.print(g_fs_agg_max / 2000.0f, 1);
  Serial.println(F(" kS/s per channel"));

  Serial.print(F("[clk] CLK_ADC_DIV = "));
  Serial.print(g_adc_div_sel);
  Serial.print(F("   (o1/o2/o3 to change)   clk_peri = "));
  Serial.print(clock_get_hz(clk_peri) / 1000000.0f, 2);
  Serial.println(F(" MHz"));

  if (g_fs_agg_meas > 0.0f) {
    Serial.print(F("[adc] last capture: fs_agg measured "));
    Serial.print(g_fs_agg_meas / 1000.0f, 1);
    Serial.print(F(" kS/s vs programmed "));
    Serial.print(g_fs_agg / 1000.0f, 1);
    Serial.print(F(" kS/s  (ratio "));
    Serial.print(g_fs_agg > 0.0f ? g_fs_agg_meas / g_fs_agg : 0.0f, 4);
    Serial.println(F(")"));
  }

  if (g_adc_clk_hz < 90000000UL) {
    Serial.println(F("[warn] clk_adc below 90 MHz. Round robin is splitting a"));
    Serial.println(F("[warn] slower clock, so per-channel rate is halved."));
    Serial.println(F("[warn] Set CPU Speed to 192 MHz in Tools, or lower b<Hz>."));
  }

  float f_cross = g_fs_agg_max / (2.0f * (float)g_cfg.m_target);
  Serial.print(F("[adc] m_target = "));
  Serial.print(g_cfg.m_target);
  Serial.print(F(" samples/cycle/ch, held up to "));
  Serial.print(f_cross / 1000.0f, 2);
  Serial.println(F(" kHz"));
  Serial.print(F("[adc] above that fs pins at the ceiling; spc falls to "));
  Serial.print((g_fs_agg_max / 2.0f) / (float)g_sw_stop, 2);
  Serial.print(F(" at "));
  Serial.print(g_sw_stop / 1000.0f, 1);
  Serial.println(F(" kHz"));

  // Harmonic folding: at m samples/cycle, harmonics m-1 and m+1 alias onto the
  // measurement bin. Worth knowing which ones before trusting the top end.
  float m_at_stop = (g_fs_agg_max / 2.0f) / (float)g_sw_stop;
  if (m_at_stop < 12.0f) {
    Serial.print(F("[warn] at sweep stop, harmonics "));
    Serial.print((int)(m_at_stop - 1.0f));
    Serial.print(F(" and "));
    Serial.print((int)(m_at_stop + 1.0f));
    Serial.println(F(" fold onto the measurement bin."));
    Serial.println(F("[warn] this is a bias, not noise -- averaging will not remove it."));
  }

  Serial.print(F("[adc] skew at 1 kHz = "));
  captureSetRate(2.0f * (float)g_cfg.m_target * 1000.0f);
  Serial.print(360.0f * 1000.0f * g_skew_s, 3);
  Serial.print(F(" deg (period_cyc="));
  Serial.print(g_period_cyc);
  Serial.print(F(", fs_agg="));
  Serial.print(g_fs_agg / 1000.0f, 2);
  Serial.println(F(" kS/s)"));
}

// ---- STRIDED BUFFER HELPERS -------------------------------------------------
// buf_rr is interleaved, so everything that reads it needs a stride and an
// offset. The 0x0FFF mask is insurance: with err_in_fifo false the upper bits
// are already zero, but a mask costs nothing.

static float mean_of_s(const uint16_t* buf, uint16_t n, uint8_t stride, uint8_t off) {
  uint32_t sum = 0;
  for (uint16_t i = 0; i < n; i++) sum += (buf[off + (uint32_t)i * stride] & 0x0FFF);
  return (float)sum / (float)n;
}

static bool saturated_s(const uint16_t* buf, uint16_t n, uint8_t stride, uint8_t off) {
  for (uint16_t i = 0; i < n; i++) {
    uint16_t v = buf[off + (uint32_t)i * stride] & 0x0FFF;
    if (v <= 2 || v >= 4093) return true;
  }
  return false;
}

// ---- GOERTZEL ---------------------------------------------------------------
// Second-order IIR form. One multiply-add per sample, two state variables, no
// complex arithmetic in the loop, O(N) time and O(1) memory. f_hz need not
// land on a bin centre.
//
//   s[i] = x[i] + 2*cos(w)*s[i-1] - s[i-2],   w = 2*pi*f/fs
//   X    = exp(j*w)*s[N-1] - s[N-2]
//   re   = cos(w)*s1 - s2
//   im   = sin(w)*s1
//
// The Hann window is generated by a recursive cosine oscillator:
//   c[k] = 2*cos(d)*c[k-1] - c[k-2],  c[0]=1, c[-1]=cos(d),  d = 2*pi/(n-1)
// which yields cos(d*k) for one multiply-add per sample instead of a cosf()
// call. Amplitude drifts well under 0.1% over 4000 points in float32, which is
// irrelevant for a window shape.
//
// v3 change: reads a strided view of the interleaved capture buffer. Mean
// removal still happens via the dc argument -- it matters more than it looks,
// since both channels sit near a 1.65 V bias (~2048 counts) and Hann smears
// bin-0 energy into neighbouring bins.
static Phasor goertzel_s(const uint16_t* buf, uint16_t n,
                         uint8_t stride, uint8_t off,
                         float f_hz, float fs_hz, float dc, bool window)
{
  const float w     = 2.0f * (float)M_PI * f_hz / fs_hz;
  const float cw    = cosf(w);
  const float sw    = sinf(w);
  const float coeff = 2.0f * cw;

  float s1 = 0.0f, s2 = 0.0f;

  const float d   = (n > 1) ? (2.0f * (float)M_PI / (float)(n - 1)) : 0.0f;
  const float wk2 = 2.0f * cosf(d);
  float c_prev = cosf(d);   // c[-1]
  float c_cur  = 1.0f;      // c[0]

  for (uint16_t i = 0; i < n; i++) {
    float x = (float)(buf[off + (uint32_t)i * stride] & 0x0FFF) - dc;
    if (window) {
      x *= 0.5f * (1.0f - c_cur);
      float c_next = wk2 * c_cur - c_prev;
      c_prev = c_cur;
      c_cur  = c_next;
    }
    float s0 = x + coeff * s1 - s2;
    s2 = s1;
    s1 = s0;
  }

  Phasor p = { cw * s1 - s2, sw * s1 };
  p.im *= PHASOR_CONJ;
  return p;
}

static inline float phasor_to_amp_counts(Phasor p, uint16_t n, bool window) {
  float cg = window ? HANN_COHERENT_GAIN : 1.0f;
  return 2.0f * pMag(p) / ((float)n * cg);
}

// ---- RECORD LENGTH ----------------------------------------------------------
// Unchanged from v2 except that fs_hz is now a programmed value rather than a
// measured one, so the answer is repeatable.
// Precedence: n_min floor > time budget > n_max > target_cycles.
static uint16_t chooseN(uint32_t f_hz, float fs_hz, uint16_t* cycles_out) {
  if (cycles_out) *cycles_out = 0;
  if (fs_hz <= 0.0f || f_hz == 0) return g_cfg.n_min;

  float spc = fs_hz / (float)f_hz;          // samples per cycle per channel

  uint32_t ceiling = g_cfg.n_max;
  if (g_cfg.max_point_ms > 0) {
    uint32_t n_budget = (uint32_t)(fs_hz * (float)g_cfg.max_point_ms * 1e-3f);
    if (n_budget < ceiling) ceiling = n_budget;
  }
  if (ceiling > N_ABS_MAX)   ceiling = N_ABS_MAX;
  if (ceiling < g_cfg.n_min) ceiling = g_cfg.n_min;   // floor wins over budget

  uint32_t cycles = g_cfg.target_cycles;
  uint32_t need   = (uint32_t)ceilf((float)g_cfg.n_min / spc);
  if (need > cycles) cycles = need;

  uint32_t max_cycles = (uint32_t)floorf((float)ceiling / spc);
  if (max_cycles < 1) max_cycles = 1;
  if (cycles > max_cycles) cycles = max_cycles;

  long n = lroundf((float)cycles * spc);
  if (n < 3)               n = 3;
  if (n > (long)N_ABS_MAX) n = N_ABS_MAX;

  if (cycles_out) *cycles_out = (uint16_t)cycles;
  return (uint16_t)n;
}

// ---- ONE MEASUREMENT --------------------------------------------------------
// Averaging is done on Z, not on the raw channel phasors. Each capture starts
// at an arbitrary point in the AD9833's phase accumulator, so V_total and
// V_DUT carry a random common phase that differs from one repeat to the next --
// summing them across repeats would average them toward zero. Z is a ratio
// taken within a single record, so it is invariant to that common phase and
// can be summed safely.
static MeasPoint measureAt(uint32_t f_hz) {
  MeasPoint m;
  memset(&m, 0, sizeof(m));
  m.f_hz     = f_hz;
  m.flags    = FLAG_OK;
  m.averages = g_cfg.averages;

  // Schedule the sample rate for this point BEFORE choosing the record length,
  // since chooseN needs the fs it will actually run at.
  float fs_want = 2.0f * (float)g_cfg.m_target * (float)f_hz;
  if (fs_want > g_fs_agg_max) fs_want = g_fs_agg_max;
  captureSetRate(fs_want);

  uint16_t cycles = 0;
  uint16_t n = chooseN(f_hz, g_fs_hz, &cycles);
  m.n          = n;
  m.cycles     = cycles;
  m.fs_hz      = g_fs_hz;
  m.period_cyc = g_period_cyc;
  m.spc        = g_fs_hz / (float)f_hz;
  m.skew_deg   = 360.0f * (float)f_hz * g_skew_s;

  Phasor Zsum = { 0.0f, 0.0f };
  float  amp_dut_sum = 0.0f, amp_rs_sum = 0.0f;
  uint8_t reps = (g_cfg.averages < 1) ? 1 : g_cfg.averages;

  for (uint8_t k = 0; k < reps; k++) {
    uint32_t tc0 = micros();
    bool cap_ok = captureRoundRobin(n);
    m.cap_us += (micros() - tc0);
    if (!cap_ok) m.flags |= FLAG_ADC_ERR;

    // Programmed vs achieved rate. A mismatch here invalidates the Goertzel
    // bin, so it must be visible rather than silently absorbed.
    m.fs_meas_hz = g_fs_meas_ch;
    if (g_fs_agg > 0.0f) {
      float fr = g_fs_agg_meas / g_fs_agg;
      if (fr < 0.97f || fr > 1.03f) m.flags |= FLAG_FS_MISMATCH;
    }

    uint32_t tm0 = micros();

    if (saturated_s(buf_rr, n, 2, 0) || saturated_s(buf_rr, n, 2, 1)) {
      m.flags |= FLAG_SATURATE;
    }
    if (m.spc < g_cfg.min_spc) m.flags |= FLAG_MARGINAL_FS;

    float dc_tot = mean_of_s(buf_rr, n, 2, 0);
    float dc_dut = mean_of_s(buf_rr, n, 2, 1);

    Phasor Vtot = goertzel_s(buf_rr, n, 2, 0, (float)f_hz, g_fs_hz, dc_tot, g_cfg.window);
    Phasor Vdut = goertzel_s(buf_rr, n, 2, 1, (float)f_hz, g_fs_hz, dc_dut, g_cfg.window);

    // De-skew before the subtraction. ADC1 was converted g_skew_s later, so its
    // recovered phase is inflated by +2*pi*f*skew. Rotate it back -- the two
    // phasors must refer to the same instant for pSub to be meaningful.
    //
    // Getting this wrong is the single most likely bug in v3, and it has a
    // clean signature: phase error small at low frequency and growing linearly
    // with frequency. Fit phase error against f; the slope in deg/Hz divided by
    // 360 is the residual delay in seconds. Landing near one aggregate sample
    // period means this sign is inverted.
    float theta = 2.0f * (float)M_PI * (float)f_hz * g_skew_s * PHASOR_CONJ;
    Vdut = pRotate(Vdut, -theta);

    Phasor Vrs = pSub(Vtot, Vdut);

    amp_dut_sum += phasor_to_amp_counts(Vdut, n, g_cfg.window);
    amp_rs_sum  += phasor_to_amp_counts(Vrs,  n, g_cfg.window);

    Phasor Z = pScale(pDiv(Vdut, Vrs), g_rsense_ohms);
    Zsum.re += Z.re;
    Zsum.im += Z.im;

    m.calc_us += (micros() - tm0);
  }

  float inv = 1.0f / (float)reps;
  Phasor Z = pScale(Zsum, inv);
  float amp_dut = amp_dut_sum * inv;
  float amp_rs  = amp_rs_sum  * inv;

  m.v_dut_mv = counts_to_volts(amp_dut / 1.41421356f) * 1000.0f;
  m.v_rs_mv  = counts_to_volts(amp_rs  / 1.41421356f) * 1000.0f;
  if (amp_rs < g_cfg.low_snr_counts) m.flags |= FLAG_LOW_SNR;

  m.Rs      = Z.re;
  m.Xs      = Z.im;
  m.z_mag   = pMag(Z);
  m.phi_deg = atan2f(Z.im, Z.re) * 180.0f / (float)M_PI;

  // A passive two-terminal DUT must have Re(Z) >= 0. Negative means bad
  // R_sense match (catastrophic cancellation in Vtot - Vdut), aliasing, or a
  // broken de-skew correction.
  if (Z.re < 0.0f) m.flags |= FLAG_NONPHYSICAL;

  // TODO(cal): open/short compensation goes here, before decomposition.
  //   Z_corr = (Z_meas - Z_short) / (1 - (Z_meas - Z_short)/Z_open)
  // Store Z_open(f) and Z_short(f) from calibration sweeps on the same f grid.

  return m;
}

// ---- CHANNEL-MATCH SELF TEST ------------------------------------------------
// Tie GP26 and GP27 to the SAME buffered node, then run this.
//
// This is the test that validates the capture path independently of the analog
// front end, and it is worth running before trusting any impedance number:
//
//   mag_B/mag_A     should be 1.000  -> anything else is channel gain mismatch
//   raw phase diff  should equal the predicted skew, to the clock cycle
//   corrected diff  should be 0.000  -> validates the de-skew code itself
//
// If the raw difference comes out with the opposite sign to predicted, flip
// PHASOR_CONJ rather than negating the rotation by hand -- the flag flips the
// phase convention and the de-skew together, consistently.
static void channelMatchTest() {
  static const uint32_t test_f[] = { 1000, 2000, 5000, 10000,20000,30000,40000,50000,60000,70000,80000,90000,100000,110000 };
  const uint8_t nf = sizeof(test_f) / sizeof(test_f[0]);

  Serial.println();
  Serial.println(F("[match] tie GP26 and GP27 to the same node before trusting this"));
  Serial.println(F("     f_hz     n  fs_prog  fs_meas  ratio   spc   magA   magB  B/A     raw_dphi pred_skew corrected"));

  char line[248];
  for (uint8_t i = 0; i < nf; i++) {
    uint32_t f = test_f[i];

    dds.setFrequencyHz(f);
    delay(g_cfg.settle_ms > 5 ? g_cfg.settle_ms : 5);

    float fs_want = 2.0f * (float)g_cfg.m_target * (float)f;
    if (fs_want > g_fs_agg_max) fs_want = g_fs_agg_max;
    captureSetRate(fs_want);

    uint16_t cyc = 0;
    uint16_t n = chooseN(f, g_fs_hz, &cyc);

    bool ok = captureRoundRobin(n);

    float dcA = mean_of_s(buf_rr, n, 2, 0);
    float dcB = mean_of_s(buf_rr, n, 2, 1);
    Phasor A = goertzel_s(buf_rr, n, 2, 0, (float)f, g_fs_hz, dcA, g_cfg.window);
    Phasor B = goertzel_s(buf_rr, n, 2, 1, (float)f, g_fs_hz, dcB, g_cfg.window);

    float magA = phasor_to_amp_counts(A, n, g_cfg.window);
    float magB = phasor_to_amp_counts(B, n, g_cfg.window);

    float phA = atan2f(A.im, A.re) * 180.0f / (float)M_PI;
    float phB = atan2f(B.im, B.re) * 180.0f / (float)M_PI;
    float raw = phB - phA;
    while (raw > 180.0f)  raw -= 360.0f;
    while (raw < -180.0f) raw += 360.0f;

    float pred = 360.0f * (float)f * g_skew_s * PHASOR_CONJ;

    float theta = 2.0f * (float)M_PI * (float)f * g_skew_s * PHASOR_CONJ;
    Phasor Bc = pRotate(B, -theta);
    float phBc = atan2f(Bc.im, Bc.re) * 180.0f / (float)M_PI;
    float corr = phBc - phA;
    while (corr > 180.0f)  corr -= 360.0f;
    while (corr < -180.0f) corr += 360.0f;

    float fs_ratio = (g_fs_agg > 0.0f) ? (g_fs_agg_meas / g_fs_agg) : 0.0f;

    snprintf(line, sizeof(line),
      "  %7lu %5u %8.0f %8.0f %6.4f %5.1f %6.0f %6.0f %6.4f %10.3f %9.3f %9.3f%s%s",
      (unsigned long)f, (unsigned)n, g_fs_hz, g_fs_meas_ch, fs_ratio,
      g_fs_hz / (float)f,
      magA, magB, (magA > 0.0f ? magB / magA : 0.0f),
      raw, pred, corr,
      ok ? "" : "  ADC_ERR",
      (fs_ratio < 0.97f || fs_ratio > 1.03f) ? "  FS_MISMATCH" : "");
    Serial.println(line);
  }

  dds.setFrequencyHz(g_freq_hz);
  delay(g_cfg.settle_ms);
  Serial.println(F("[match] B/A ~1.000, corrected ~0.000, ratio ~1.0000."));
  Serial.println(F("[match] ratio well below 1 means the ADC is NOT keeping up with"));
  Serial.println(F("[match] the programmed divisor -- magnitudes collapse because"));
  Serial.println(F("[match] Goertzel is then looking in the wrong bin. Try 'u'."));
}

// ---- RAW DUMP ---------------------------------------------------------------
// Separates "the buffer holds a real tone we mis-binned" from "the buffer holds
// a stuck value or junk". Those two look identical through Goertzel alone.
static void dumpRaw() {
  if (g_cap_n_last == 0) {
    Serial.println(F("[err] no capture yet -- run 'y' or a measurement first"));
    return;
  }
  uint16_t n = g_cap_n_last;
  uint16_t mnA = 4095, mxA = 0, mnB = 4095, mxB = 0;
  for (uint16_t i = 0; i < n; i++) {
    uint16_t a = buf_rr[2u * i]      & 0x0FFF;
    uint16_t b = buf_rr[2u * i + 1u] & 0x0FFF;
    if (a < mnA) mnA = a;
    if (a > mxA) mxA = a;
    if (b < mnB) mnB = b;
    if (b > mxB) mxB = b;
  }

  Serial.println();
  Serial.print(F("[raw] n_per_ch="));      Serial.print(n);
  Serial.print(F("  run_us="));            Serial.print(g_cap_run_us);
  Serial.print(F("  period_cyc="));        Serial.print(g_period_cyc);
  Serial.print(F("  clk_adc="));           Serial.print(g_adc_clk_hz / 1000000.0f, 2);
  Serial.println(F(" MHz"));
  Serial.print(F("[raw] fs_agg programmed "));
  Serial.print(g_fs_agg / 1000.0f, 1);
  Serial.print(F(" kS/s, measured "));
  Serial.print(g_fs_agg_meas / 1000.0f, 1);
  Serial.println(F(" kS/s"));
  Serial.print(F("[raw] chA (V_total) min/max/pp = "));
  Serial.print(mnA); Serial.print('/'); Serial.print(mxA); Serial.print('/');
  Serial.println(mxA - mnA);
  Serial.print(F("[raw] chB (V_DUT)   min/max/pp = "));
  Serial.print(mnB); Serial.print('/'); Serial.print(mxB); Serial.print('/');
  Serial.println(mxB - mnB);

  uint16_t lim = (n < 32u) ? n : 32u;
  Serial.print(F("[raw] first ")); Serial.print(lim);
  Serial.println(F(" pairs as A,B:"));
  for (uint16_t i = 0; i < lim; i++) {
    Serial.print(buf_rr[2u * i]      & 0x0FFF); Serial.print(',');
    Serial.print(buf_rr[2u * i + 1u] & 0x0FFF);
    if ((i % 8u) == 7u) Serial.println();
    else                Serial.print(F("   "));
  }
  Serial.println();
  Serial.println(F("[raw] pp near zero on both channels = no signal reaching the ADC."));
  Serial.println(F("[raw] healthy pp with tiny Goertzel magnitude = wrong bin, i.e. fs."));
}

