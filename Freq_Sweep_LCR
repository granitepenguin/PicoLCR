static void applyProfile(int idx) {
  switch (idx) {
    case 0: g_cfg = PROFILE_FAST;    g_profile_name = "fast";    break;
    case 1: g_cfg = PROFILE_NORMAL;  g_profile_name = "normal";  break;
    case 2: g_cfg = PROFILE_PRECISE; g_profile_name = "precise"; break;
    default: Serial.println(F("\n[err] profile must be 0, 1 or 2")); return;
  }
  Serial.print(F("\n[ok] profile = ")); Serial.println(g_profile_name);
}

// Any manual tweak invalidates the profile label.
static inline void markCustom() { g_profile_name = "custom"; }

static void handleSerial() {
  static char line[32];
  static uint8_t idx = 0;

  while (Serial.available()) {
    char ch = (char)Serial.read();
    if (ch == '\r') continue;
    if (ch != '\n' && idx < sizeof(line) - 1) { line[idx++] = ch; continue; }

    line[idx] = '\0';
    if (idx == 0) continue;
    char cmd = line[0];
    const char* arg = &line[1];
    idx = 0;

    switch (cmd) {
      case 'f': case 'F': {
        uint32_t hz = (uint32_t)atol(arg);
        if (hz >= 1 && hz <= 1000000UL) {
          g_freq_hz = hz;
          dds.setFrequencyHz(g_freq_hz);
          delay(g_cfg.settle_ms);
          Serial.print(F("\n[ok] f = ")); Serial.print(g_freq_hz); Serial.println(F(" Hz"));
        } else Serial.println(F("\n[err] frequency out of range"));
        break;
      }
      case 'a': case 'A': g_sw_start = (uint32_t)atol(arg);
        Serial.print(F("\n[ok] sweep start = ")); Serial.println(g_sw_start); break;
      case 'b': case 'B': g_sw_stop = (uint32_t)atol(arg);
        Serial.print(F("\n[ok] sweep stop = ")); Serial.println(g_sw_stop); break;
      case 'p': case 'P': g_sw_step = (uint32_t)atol(arg);
        Serial.print(F("\n[ok] sweep step = ")); Serial.println(g_sw_step); break;
      case 'S': runSweep(); if (g_live) printLiveHeader(); break;
      case 'd': case 'D': dumpSweep(); break;

      case 'r': case 'R': {
        float ohms = atof(arg);
        if (ohms > 0.0f) { g_rsense_ohms = ohms;
          Serial.print(F("\n[ok] R_sense = ")); Serial.println(g_rsense_ohms); }
        else Serial.println(F("\n[err] R_sense must be > 0"));
        break;
      }

      case 'g': case 'G': applyProfile(atoi(arg)); break;

      case 'c': case 'C': {
        int v = atoi(arg);
        if (v >= 3 && v <= 512) { g_cfg.m_target = (uint16_t)v; markCustom();
          Serial.print(F("\n[ok] m_target = ")); Serial.print(g_cfg.m_target);
          Serial.print(F(" samples/cycle/ch, held up to "));
          Serial.print(g_fs_agg_max / (2.0f * (float)v) / 1000.0f, 2);
          Serial.println(F(" kHz")); }
        else Serial.println(F("\n[err] m_target must be 3..512"));
        break;
      }

      case 'n': {
        int c = atoi(arg);
        if (c >= 1 && c <= 4096) { g_cfg.target_cycles = (uint16_t)c; markCustom();
          Serial.print(F("\n[ok] target_cycles = ")); Serial.println(g_cfg.target_cycles); }
        else Serial.println(F("\n[err] cycles must be 1..4096"));
        break;
      }
      case 'v': {
        int a = atoi(arg);
        if (a >= 1 && a <= 64) { g_cfg.averages = (uint8_t)a; markCustom();
          Serial.print(F("\n[ok] averages = ")); Serial.println(g_cfg.averages); }
        else Serial.println(F("\n[err] averages must be 1..64"));
        break;
      }
      case 'i': {
        int v = atoi(arg);
        if (v >= 3 && v <= (int)N_ABS_MAX) { g_cfg.n_min = (uint16_t)v; markCustom();
          if (g_cfg.n_max < g_cfg.n_min) g_cfg.n_max = g_cfg.n_min;
          Serial.print(F("\n[ok] n_min = ")); Serial.println(g_cfg.n_min); }
        else Serial.println(F("\n[err] n_min out of range"));
        break;
      }
      case 'j': {
        int v = atoi(arg);
        if (v >= 3 && v <= (int)N_ABS_MAX) { g_cfg.n_max = (uint16_t)v; markCustom();
          if (g_cfg.n_min > g_cfg.n_max) g_cfg.n_min = g_cfg.n_max;
          Serial.print(F("\n[ok] n_max = ")); Serial.println(g_cfg.n_max); }
        else Serial.println(F("\n[err] n_max out of range"));
        break;
      }
      case 'x': {
        int v = atoi(arg);
        if (v >= 0 && v <= 10000) { g_cfg.max_point_ms = (uint16_t)v; markCustom();
          Serial.print(F("\n[ok] max_point_ms = ")); Serial.println(g_cfg.max_point_ms); }
        break;
      }
      case 'e': {
        int v = atoi(arg);
        if (v >= 0 && v <= 5000) { g_cfg.settle_ms = (uint16_t)v; markCustom();
          Serial.print(F("\n[ok] settle_ms = ")); Serial.println(g_cfg.settle_ms); }
        break;
      }
      case 'w': case 'W': g_cfg.window = !g_cfg.window; markCustom();
        Serial.print(F("\n[ok] window = ")); Serial.println(g_cfg.window ? F("hann") : F("none")); break;

      case 'y': case 'Y': channelMatchTest(); if (g_live) printLiveHeader(); break;
      case 't': case 'T': timingReport();     if (g_live) printLiveHeader(); break;
      case 'k': case 'K': adcReport();        if (g_live) printLiveHeader(); break;
      case 'm': case 'M': g_live = !g_live;
        Serial.print(F("\n[ok] live = ")); Serial.println(g_live ? F("on") : F("off"));
        if (g_live) printLiveHeader();
        break;
      case 'o': case 'O': {
        int v = atoi(arg);
        if (v >= 1 && v <= 3) {
          adcClockBoost((uint32_t)v);
          Serial.print(F("\n[ok] CLK_ADC_DIV = "));  Serial.print(v);
          Serial.print(F("  clk_adc = "));
          Serial.print(g_adc_clk_hz / 1000000.0f, 2);
          Serial.print(F(" MHz  fs_agg_max = "));
          Serial.print(g_fs_agg_max / 1000.0f, 1);
          Serial.print(F(" kS/s  ("));
          Serial.print(g_fs_agg_max / 2000.0f, 1);
          Serial.println(F(" kS/s per channel)"));
          Serial.println(F("[hint] re-run 'y' and watch the ratio column."));
        } else {
          Serial.println(F("\n[err] divisor must be 1, 2 or 3"));
        }
        break;
      }
      case 'u': case 'U': dumpRaw(); if (g_live) printLiveHeader(); break;
      case '?': printSettings(); break;
      case 'h': case 'H': printHelp(); break;
      default:
        Serial.print(F("\n[err] unknown command: ")); Serial.println(line);
    }
  }
}

// ---- SETUP / LOOP -----------------------------------------------------------
void setup() {
  // Clock first, before anything derives a divider from it. USB CDC runs off
  // PLL_USB so it survives a clk_sys change, but SPI dividers come from
  // clk_peri which follows clk_sys -- the AD9833 driver calls beginTransaction()
  // on every register write, so its baud is recomputed and stays correct.
  g_sysclk_ok = ensureSysClock();

  // Pin clk_peri to PLL_USB so changing clk_sys does not shift SPI or UART
  // baud. Recommended in the RP2040 ADC overclocking writeups.
  clock_configure(clk_peri, 0,
                  CLOCKS_CLK_PERI_CTRL_AUXSRC_VALUE_CLKSRC_PLL_USB,
                  48 * 1000000, 48 * 1000000);

  Serial.begin(115200);
  while (!Serial && millis() < 2000) {}

  Serial.println();
  Serial.println(F("PicoLCR POC v6.1 (round-robin ADC + DMA + Goertzel) starting..."));

  if (!g_sysclk_ok) {
    Serial.print(F("[warn] could not reach "));
    Serial.print(TARGET_SYS_KHZ / 1000);
    Serial.println(F(" MHz clk_sys. Running derated -- see 'k'."));
  }

  adcClockBoost(g_adc_div_sel);
  captureInit();

  // NOTE: do not call analogRead() or analogReadResolution() anywhere in this
  // sketch. The Arduino core's analogRead reconfigures the same ADC hardware
  // (AINSEL, FIFO, divisor) and will fight captureRoundRobin().

  if (!dds.begin(g_freq_hz)) {
    Serial.println(F("AD9833 begin() FAILED"));
    while (true) { delay(1000); }
  }
  Serial.println(F("AD9833 running."));

  adcReport();
  printSettings();
  printHelp();
  Serial.println();
  Serial.println(F("[hint] first run: 'y' with GP26/GP27 tied together validates"));
  Serial.println(F("[hint] the capture path before you trust any impedance."));
  Serial.println(F("[hint] watch the new fs_meas / ratio columns. Then try 'o1'"));
  Serial.println(F("[hint] for 2 MS/s aggregate and re-run 'y' to see if it holds."));
  printLiveHeader();
  delay(100);
}

void loop() {
  static uint32_t last_ms = 0;
  handleSerial();

  if (!g_live) return;
  if ((uint32_t)(millis() - last_ms) < 200) return;
  last_ms = millis();

  printLiveRow(measureAt(g_freq_hz));
}
