// ---- COMPLEX HELPERS --------------------------------------------------------
struct Phasor { float re, im; };

static inline Phasor pSub(Phasor a, Phasor b)  { return { a.re - b.re, a.im - b.im }; }
static inline Phasor pScale(Phasor a, float s) { return { a.re * s, a.im * s }; }
static inline float  pMag(Phasor a)            { return sqrtf(a.re*a.re + a.im*a.im); }

static inline Phasor pDiv(Phasor a, Phasor b) {
  float d = b.re*b.re + b.im*b.im;
  if (d <= 0.0f) return { 0.0f, 0.0f };
  return { (a.re*b.re + a.im*b.im) / d,
           (a.im*b.re - a.re*b.im) / d };
}

static inline Phasor pRotate(Phasor a, float theta) {
  float c = cosf(theta), s = sinf(theta);
  return { a.re*c - a.im*s, a.re*s + a.im*c };
}

static inline float counts_to_volts(float counts) {
  return counts * (ADC_VREF / ADC_FULLSCALE);
}

// =============================================================================
//                          CLOCK + CAPTURE PATH
