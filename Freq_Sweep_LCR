  Serial.print  (F("# r_sense_ohm="));   Serial.println(g_rsense_ohms, 2);
  Serial.print  (F("# clk_sys_hz="));    Serial.print(clock_get_hz(clk_sys));
  Serial.print  (F(" clk_adc_hz="));     Serial.print(g_adc_clk_hz);
  Serial.print  (F(" fs_agg_max="));     Serial.println(g_fs_agg_max, 0);
  Serial.print  (F("# profile="));       Serial.println(g_profile_name);
  Serial.print  (F("# m_target="));      Serial.print(g_cfg.m_target);
  Serial.print  (F(" target_cycles=")); Serial.print(g_cfg.target_cycles);
  Serial.print  (F(" n_min="));          Serial.print(g_cfg.n_min);
  Serial.print  (F(" n_max="));          Serial.print(g_cfg.n_max);
  Serial.print  (F(" averages="));       Serial.print(g_cfg.averages);
  Serial.print  (F(" window="));         Serial.println(g_cfg.window ? F("hann") : F("none"));
  Serial.print  (F("# settle_ms="));     Serial.print(g_cfg.settle_ms);
  Serial.print  (F(" max_point_ms="));   Serial.print(g_cfg.max_point_ms);
  Serial.print  (F(" min_spc="));        Serial.println(g_cfg.min_spc, 1);
