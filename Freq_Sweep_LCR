  Serial.print  (F(" step_hz="));        Serial.println(g_sw_step);
  Serial.print  (F("# phasor_conj="));   Serial.println(PHASOR_CONJ, 0);
  Serial.println(F("f_hz,z_mag_ohm,phase_deg,Rs_ohm,Xs_ohm,Cs_F,Ls_H,"
                   "v_dut_mvrms,v_rs_mvrms,n_samples,cycles,integ_ms,"
                   "fs_ch_hz,fs_meas_ch_hz,spc,period_cyc,skew_deg,"
                   "averages,cap_us,calc_us,flags,ok"));
}

static void printCsvRow(const MeasPoint& m) {
  float omega = 2.0f * (float)M_PI * (float)m.f_hz;
  float Cs_F  = (m.Xs < 0.0f && omega > 0.0f) ? (-1.0f / (omega * m.Xs)) : 0.0f;
  float Ls_H  = (m.Xs > 0.0f && omega > 0.0f) ? ( m.Xs /  omega        ) : 0.0f;
  float integ_ms = (m.fs_hz > 0.0f) ? ((float)m.n / m.fs_hz * 1000.0f) : 0.0f;

  // 'ok' is the single column to filter on in a spreadsheet: 1 means the
  // capture was clean and Re(Z) was physical.
  int ok = ((m.flags & (FLAG_ADC_ERR | FLAG_NONPHYSICAL | FLAG_SATURATE
                        | FLAG_FS_MISMATCH)) == 0) ? 1 : 0;

  char line[288];
  snprintf(line, sizeof(line),
    "%lu,%.4g,%.3f,%.4g,%.4g,%.6g,%.6g,%.2f,%.2f,%u,%u,%.3f,"
    "%.0f,%.0f,%.2f,%lu,%.3f,%u,%lu,%lu,0x%02X,%d",
    (unsigned long)m.f_hz,
    m.z_mag, m.phi_deg, m.Rs, m.Xs,
    Cs_F, Ls_H,
    m.v_dut_mv, m.v_rs_mv,
    (unsigned)m.n, (unsigned)m.cycles, integ_ms,
    m.fs_hz, m.fs_meas_hz, m.spc, (unsigned long)m.period_cyc, m.skew_deg,
    (unsigned)m.averages,
    (unsigned long)m.cap_us, (unsigned long)m.calc_us,
    m.flags, ok);
  Serial.println(line);
}

static void dumpSweep() {
  if (g_sweep_count == 0) { Serial.println(F("[err] no sweep in RAM, run S first")); return; }
  printCsvHeader();
  for (uint16_t i = 0; i < g_sweep_count; i++) printCsvRow(g_sweep[i]);
  Serial.print(F("# points=")); Serial.println(g_sweep_count);
}

// ---- TIMING REPORT ----------------------------------------------------------
// Measures the sweep start, midpoint and stop, then extrapolates the sweep
// duration. Run this before committing to a profile change.
static void timingReport() {
  Serial.println();
  Serial.println(F("[timing] measuring..."));

  uint32_t f_mid = g_sw_start + (g_sw_stop - g_sw_start) / 2;

  dds.setFrequencyHz(g_sw_start); delay(g_cfg.settle_ms);
  uint32_t t0 = micros();
  MeasPoint lo = measureAt(g_sw_start);
  uint32_t lo_us = micros() - t0;

  dds.setFrequencyHz(f_mid); delay(g_cfg.settle_ms);
  t0 = micros();
  MeasPoint mid = measureAt(f_mid);
  uint32_t mid_us = micros() - t0;

  dds.setFrequencyHz(g_sw_stop); delay(g_cfg.settle_ms);
  t0 = micros();
  MeasPoint hi = measureAt(g_sw_stop);
  uint32_t hi_us = micros() - t0;

  dds.setFrequencyHz(g_freq_hz); delay(g_cfg.settle_ms);

  Serial.println(F("     f_hz     n  cyc    fs_ch   spc  integ_ms   cap_us  calc_us  total_us"));

  char line[144];
  const MeasPoint* pts[3] = { &lo, &mid, &hi };
  uint32_t tot[3] = { lo_us, mid_us, hi_us };
  for (uint8_t i = 0; i < 3; i++) {
    const MeasPoint& m = *pts[i];
    float integ_ms = (m.fs_hz > 0.0f) ? ((float)m.n / m.fs_hz * 1000.0f) : 0.0f;
    snprintf(line, sizeof(line),
      "  %7lu %5u %4u %8.0f %5.1f  %8.2f  %7lu %8lu  %8lu",
      (unsigned long)m.f_hz, (unsigned)m.n, (unsigned)m.cycles,
      m.fs_hz, m.spc, integ_ms,
      (unsigned long)m.cap_us, (unsigned long)m.calc_us, (unsigned long)tot[i]);
    Serial.println(line);
  }

  uint32_t n_pts  = (g_sw_step > 0) ? ((g_sw_stop - g_sw_start) / g_sw_step + 1) : 1;
  float    avg_ms = (float)(lo_us + mid_us + hi_us) / 3000.0f + (float)g_cfg.settle_ms;
  Serial.print(F("  estimated sweep: "));
  Serial.print(n_pts);
  Serial.print(F(" points x ~"));
  Serial.print(avg_ms, 1);
  Serial.print(F(" ms = ~"));
  Serial.print(n_pts * avg_ms / 1000.0f, 1);
  Serial.println(F(" s"));
}

// ---- SWEEP ------------------------------------------------------------------
static void runSweep() {
  if (g_sw_step == 0 || g_sw_stop < g_sw_start) {
    Serial.println(F("[err] bad sweep range"));
    return;
  }

  uint32_t n_pts = (g_sw_stop - g_sw_start) / g_sw_step + 1;
  if (n_pts > MAX_SWEEP_POINTS) {
    Serial.print(F("[warn] "));
    Serial.print(n_pts);
    Serial.print(F(" points requested, storing first "));
    Serial.print(MAX_SWEEP_POINTS);
    Serial.println(F(" (all points still stream to CSV)"));
  }

  g_sweep_count = 0;
  Serial.println();
  Serial.println(F("### SWEEP BEGIN"));
  printCsvHeader();

  uint16_t adc_err_count = 0;

  uint32_t t0 = millis();
  for (uint32_t f = g_sw_start; f <= g_sw_stop; f += g_sw_step) {
    dds.setFrequencyHz(f);
    delay(g_cfg.settle_ms);

    MeasPoint m = measureAt(f);
    if (m.flags & FLAG_ADC_ERR) adc_err_count++;

    printCsvRow(m);                                   // stream first, store second
    if (g_sweep_count < MAX_SWEEP_POINTS) g_sweep[g_sweep_count++] = m;

    if (Serial.available() && Serial.peek() == 'q') {
      Serial.read();
      Serial.println(F("# aborted"));
      break;
    }
  }

  Serial.print(F("# points="));     Serial.println(g_sweep_count);
  Serial.print(F("# elapsed_ms=")); Serial.println(millis() - t0);
  if (adc_err_count) {
    Serial.print(F("# WARNING adc_err_points=")); Serial.println(adc_err_count);
    Serial.println(F("# FIFO overflow or parity slip. Those rows have ok=0."));
  }
  Serial.println(F("### SWEEP END"));
  Serial.println();

  dds.setFrequencyHz(g_freq_hz);
  delay(g_cfg.settle_ms);
}

// ---- LIVE MONITOR -----------------------------------------------------------
static void printLiveHeader() {
  Serial.println();
  Serial.println(F("    time |    f   |  V_DUT  V_Rs  |     |Z|     phase |   Rs       Xs    |   Cs/Ls   |    N  spc  flg"));
  Serial.println(F("    (ms) |  (Hz)  |  (mV)   (mV)  |    (ohms)   (deg) |  (ohms)   (ohms) |  (val)    |"));
  Serial.println(F("---------+--------+---------------+-------------------+------------------+-----------+----------------"));
}

static void printLiveRow(const MeasPoint& m) {
  float omega = 2.0f * (float)M_PI * (float)m.f_hz;
  char val[24];

  if (m.Xs < 0.0f) {
    float Cs_nF = (-1.0f / (omega * m.Xs)) * 1e9f;
    if (Cs_nF >= 1.0f) snprintf(val, sizeof(val), "%7.2f nF", Cs_nF);
    else               snprintf(val, sizeof(val), "%7.1f pF", Cs_nF * 1000.0f);
  } else if (m.Xs > 0.0f) {
    float Ls_mH = (m.Xs / omega) * 1e3f;
    if (Ls_mH >= 1.0f) snprintf(val, sizeof(val), "%7.3f mH", Ls_mH);
    else               snprintf(val, sizeof(val), "%7.1f uH", Ls_mH * 1000.0f);
  } else {
    snprintf(val, sizeof(val), "   --   ");
  }

  char line[224];
  snprintf(line, sizeof(line),
    "%8lu | %6lu | %6.1f %6.1f | %9.1f %6.1f | %8.1f %8.1f | %s | %4u %4.0f 0x%02X",
    (unsigned long)millis(), (unsigned long)m.f_hz,
    m.v_dut_mv, m.v_rs_mv, m.z_mag, m.phi_deg, m.Rs, m.Xs,
    val, (unsigned)m.n, m.spc, m.flags);
  Serial.println(line);
}

